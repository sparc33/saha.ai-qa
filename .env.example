# Copy this file to .env and fill in real, non-production values.
# .env itself is gitignored — never commit real values.
#
# Cross-check every URL here against qa-fleet.config.json -> browserAutomation
# in the QA fleet repo (C:\ARC QA) before use. A host that isn't allow-listed
# there will be refused by ui-selector-discovery.agent.md / test-execution-runner.agent.md's
# environment-safety gate — that's intentional, not a bug to work around.

PATIENT_CHAT_BASE_URL=
CLINICIAN_DASHBOARD_BASE_URL=
CONVERSATION_API_BASE_URL=

# clinician-dashboard-ui requires auth (confirmed by PRD: AC-021.2 / INT-009) —
# patient-chat-ui does not (BRULE-052: session token or pre-visit link only).
# A dedicated non-production test account's credentials — never a real clinician's.
CLINICIAN_TEST_USERNAME=
CLINICIAN_TEST_PASSWORD=

# A second clinic's dedicated non-production test account — needed only for the
# tenant-isolation risk-gated scenarios (100011/100012), which require two distinct
# clinics to prove cross-clinic access is denied. Multi-clinic test provisioning isn't
# defined by any story yet; leave unset and those two tests will skip with a clear reason
# rather than fail, until a real second-clinic account exists.
CLINICIAN_TEST_USERNAME_CLINIC_B=
CLINICIAN_TEST_PASSWORD_CLINIC_B=

# OPEN GAP, not solved here: how a test obtains a real OTP for a synthetic patient identifier
# is unconfirmed — a real SMS-delivered OTP can't be read programmatically without either a
# test-mode bypass or an interception mechanism, and no story defines one. This assumes a
# bypass code exists once the dev team confirms one; the patient-record-matching tests that
# reference it will fail at the verify-OTP step (not skip) until this is actually resolved —
# left visible in run output on purpose rather than silently skipped.
OTP_TEST_BYPASS_CODE=

# Set only if/when conversation-api requires a token for test requests.
# Name only — never a real token value, here or anywhere else in this repo.
# API_TOKEN=

# Xray/Jira credentials — used by xray-csv-importer.agent.md, test-execution-runner.agent.md,
# and xray-execution-runbook-publisher.agent.md in the QA fleet (C:\ARC QA).
# XRAY_CLIENT_ID / XRAY_CLIENT_SECRET: Xray Cloud -> Global Settings -> API Keys -> Create API Key
# JIRA_EMAIL / JIRA_API_TOKEN: id.atlassian.com/manage-profile/security/api-tokens
# If a token was ever pasted into a chat or committed to a file by mistake, revoke and
# regenerate it before using it here — treat any such value as already compromised.
XRAY_CLIENT_ID=
XRAY_CLIENT_SECRET=
JIRA_EMAIL=
JIRA_API_TOKEN=
